rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Congregations - allow read for publisher code verification, write for admin
    match /congregations/{congregationId} {
      allow read: if true; // Allow read for publisher code verification
      allow write: if true; // Allow write for admin setup
    }
    
    // Preachers - allow read/write for now (will be filtered by server-side code)
    match /preachers/{preacherId} {
      allow read, write: if true;
    }
    
    // Locations - allow read/write for now (will be filtered by server-side code)
    match /locations/{locationId} {
      allow read, write: if true;
    }
    
    // Bookings - allow read/write for now (will be filtered by server-side code)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    
    // Publisher codes - allow read/write for now (will be filtered by server-side code)
    match /publisherCodes/{codeId} {
      allow read, write: if true;
    }
  }
}
